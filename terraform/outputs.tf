output "s3_access_key" {
  description = "Access key for application Object Storage"
  value       = yandex_iam_service_account_static_access_key.app.access_key
  sensitive   = true
}

output "s3_secret_key" {
  description = "Secret key for application Object Storage"
  value       = yandex_iam_service_account_static_access_key.app.secret_key
  sensitive   = true
}

output "s3_bucket" {
  description = "Bucket name for application Object Storage"
  value       = yandex_storage_bucket.app.bucket
}

output "s3_region" {
  description = "Region for application Object Storage"
  value       = replace(var.server_zone, "/-[a-z]$/", "")
}

output "s3_endpoint" {
  description = "Endpoint for Yandex Cloud Object Storage"
  value       = "https://storage.yandexcloud.net"
}

output "database_host" {
  description = "Read-write endpoint for the Managed PostgreSQL cluster"
  value       = "c-${module.yandex_postgresql.cluster_id}.rw.mdb.yandexcloud.net"
}

output "database_name" {
  description = "Application database name"
  value       = var.db_name
}

output "database_username" {
  description = "Database username created by the PostgreSQL module"
  value = one([
    for owner in module.yandex_postgresql.owners_data : owner.user
    if owner.user == var.db_user
  ])
  sensitive = true
}

output "database_password" {
  description = "Database password generated by the PostgreSQL module"
  value = one([
    for owner in module.yandex_postgresql.owners_data : owner.password
    if owner.user == var.db_user
  ])
  sensitive = true
}